# Fork build for the AAS Web UI, used by AP2030-UNS.
#
# Upstream's own `aas-web-ui/Dockerfile` is left untouched so that merging
# `upstream/main` into this fork stays clean. This file is identical to it
# except for the build step, and that difference is deliberate:
#
# `pnpm build` triggers `prebuild`, which is `run-s lint:check test:run
# type-check` over the *whole* upstream application. That re-runs upstream's
# 1641-test suite on every rebuild, which costs ~4 minutes of the build and,
# more importantly, is flaky: `tests/router/OAuth2CallbackRouting.test.ts` has a
# hard 30 s timeout that it exceeds whenever the build competes with a running
# stack for CPU.
#
# Upstream already gates its own code in its own CI. Re-running that gate on
# every image build buys nothing here, so this Dockerfile runs the same
# quality gate with a tolerant test timeout, then builds. Run the gate
# unmodified with `pnpm build` when you want upstream's exact behaviour.
#
# Build with the `aas-web-ui` directory as the context:
#   docker build -f Dockerfile.ci -t aas-gui .

FROM --platform=$BUILDPLATFORM node:24-slim AS build-stage
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NODE_OPTIONS=--max-old-space-size=8192
ARG VITE_APP_VERSION
ARG VITE_APP_COMMIT_SHA
ARG VITE_APP_BUILD_DATE
ENV NODE_OPTIONS=$NODE_OPTIONS
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_APP_COMMIT_SHA=$VITE_APP_COMMIT_SHA
ENV VITE_APP_BUILD_DATE=$VITE_APP_BUILD_DATE
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
RUN corepack enable
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
  pnpm install --frozen-lockfile
COPY . .
ENV NODE_OPTIONS=--max-old-space-size=4096
# The equivalent of `pnpm build` (lint -> vitest -> vue-tsc -> vite build),
# with a test timeout that does not turn CPU contention into a red build.
RUN pnpm run lint:check \
 && pnpm exec vitest run --testTimeout=180000 \
 && pnpm run type-check \
 && pnpm exec vite build
RUN pnpm bff:build

FROM node:24-slim AS edc-bff-stage
ARG HTTP_PROXY
ARG HTTPS_PROXY
WORKDIR /usr/src/app
ENV NODE_ENV=production
ENV CX_EDC_BFF_PORT=3001
COPY --from=build-stage /app/dist-bff /usr/src/app/dist-bff
EXPOSE 3001
CMD ["node", "/usr/src/app/dist-bff/edc-bff/server.js"]

FROM nginx:mainline-alpine-slim AS production-stage
ARG HTTP_PROXY
ARG HTTPS_PROXY
WORKDIR /usr/src/app
RUN apk add --no-cache jq gettext 'nodejs~24'
RUN addgroup -g 1000 -S mygroup && \
  adduser -u 1000 -D -S -G mygroup myuser
COPY --from=build-stage /app/dist /usr/src/app/dist
COPY --from=build-stage /app/dist-bff /usr/src/app/dist-bff
COPY nginx.conf /etc/nginx/nginx.conf.template
COPY entrypoint.sh /usr/src/app/entrypoint.sh
RUN chmod +x /usr/src/app/entrypoint.sh
RUN chown -R myuser:mygroup /usr/src/app /var/cache/nginx /tmp /usr/share/nginx/html
RUN chmod -R 777 /usr/src/app /var/cache/nginx /tmp /etc/nginx
USER myuser
ENTRYPOINT ["/usr/src/app/entrypoint.sh"]
